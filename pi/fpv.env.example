# -------------------------------------------------------------------
# FPV Pi deployment configuration
# -------------------------------------------------------------------
# Installed to ~/fpv/fpv.env by setup.sh (mode 0600, owner-only).
# All FPV systemd services load this file via EnvironmentFile=. Values set
# here OVERRIDE the defaults baked into the unit files and scripts.
#
# Edit these values after running setup.sh, then:
#   sudo systemctl daemon-reload
#   sudo systemctl restart fpv-video fpv-control fpv-audio-tx fpv-audio-rx

# -- Server connection -----------------------------------------------

# IP or hostname of the server running docker-compose (Janus + control relay).
# If using Tailscale, use the server's Tailscale IP (run `tailscale ip -4`
# on the server).
JANUS_HOST=YOUR_SERVER_IP

# Control relay UDP endpoint (same server). The Pi daemon sends a hello /
# telemetry datagram to this address a few times per second, which both opens
# the return path through LTE carrier NAT and tells the relay where to send
# control frames. Must match UDP_PORT in server/.env (default 3002).
CONTROL_RELAY_HOST=YOUR_SERVER_IP
CONTROL_RELAY_PORT=3002

# Shared auth token. Must match CONTROL_AUTH_TOKEN in server/.env. It is also
# the HMAC key that authenticates every control datagram.
# Generate one with: openssl rand -hex 32
AUTH_TOKEN=changeme

# -- Video -----------------------------------------------------------

# Preset: latency | balanced | quality
#   latency  - 640x480  @ 60 fps, 1.2 Mbps  (lowest glass-to-glass delay)
#   balanced - 1280x720 @ 30 fps, 2.0 Mbps
#   quality  - 1920x1080 @ 30 fps, 3.5 Mbps (needs a strong uplink)
VIDEO_PRESET=latency

# Any of the following override the chosen preset when uncommented.
#VIDEO_WIDTH=640
#VIDEO_HEIGHT=480
#VIDEO_FRAMERATE=60
#VIDEO_BITRATE=1200000
#KEYFRAME_INTERVAL=30
#VIDEO_H264_LEVEL=4

# Camera tuning. 'sport' keeps exposure short so motion stays sharp.
#VIDEO_EXPOSURE=sport
#VIDEO_AWB=auto
# Fixed shutter in microseconds (disables auto exposure when set).
#VIDEO_SHUTTER_US=
# Force a sensor mode, e.g. 1296:972:10 (width:height:bit-depth). Leave unset
# to let libcamera pick the closest native mode.
#VIDEO_SENSOR_MODE=
# Extra raw arguments appended to rpicam-vid.
#VIDEO_EXTRA_ARGS=

# Capture stack: auto | rpicam | raspivid | software
#   rpicam   - rpicam-vid / libcamera-vid, VideoCore IV hardware H.264 encoder
#   raspivid - legacy firmware camera stack (needs start_x=1), hardware encoder
#   software - GStreamer + x264enc on the CPU (last resort)
#CAMERA_STACK=auto

# -- Audio -----------------------------------------------------------

# ALSA devices by card id (stable across reboots). Run
# `scripts/fpv-audio-detect.sh` to list candidates and write these two lines.
#MIC_DEVICE=plughw:CARD=Device,DEV=0
#SPK_DEVICE=plughw:CARD=Device,DEV=0

# Opus frame size in ms for the Pi -> browser leg (2.5, 5, 10, 20, 40, 60).
#OPUS_FRAME_SIZE=10
# Jitter buffer for the browser -> Pi leg in ms.
#JITTER_LATENCY_MS=40

# -- Control daemon --------------------------------------------------

#SERIAL_PORT=/dev/fpv-arduino
#SERIAL_BAUD=500000
