# -------------------------------------------------------------------
# FPV Pi deployment secrets
# -------------------------------------------------------------------
# Installed to ~/fpv/fpv.env by setup.sh (mode 0600, owner-only).
# All four FPV systemd services load this file via EnvironmentFile=.
#
# Edit these values after running setup.sh, then:
#   sudo systemctl daemon-reload
#   sudo systemctl restart fpv-video fpv-control fpv-audio-tx fpv-audio-rx

# -- Server connection -----------------------------------------------

# IP or hostname of the server running docker-compose (Janus + control relay).
# If using Tailscale, use the server's Tailscale IP (run `tailscale ip -4`
# on the server).
JANUS_HOST=YOUR_SERVER_IP

# WebSocket URL of the control relay (same server, port 3001).
CONTROL_SERVER=ws://YOUR_SERVER_IP:3001

# Shared auth token. Must match CONTROL_AUTH_TOKEN in server/.env.
# Generate one with: openssl rand -hex 32
AUTH_TOKEN=changeme
