# FPV network shaping configuration.
# Installed to /etc/default/fpv-network by setup.sh and read by the
# NetworkManager dispatcher script (/etc/NetworkManager/dispatcher.d/90-fpv-qos)
# and the link manager (fpv-link-manager.service).
#
# Uplink caps are in kilobits per second. Set each to roughly 85-90% of the
# *measured* upstream rate of that link (for example, measure with
# `iperf3 -c <server> -u -b 20M -R` run from the server side, or a speed test
# from the Pi). A cap above the real rate does nothing; a cap far below it
# wastes bandwidth.

# Set to 0 to disable shaping entirely.
FPV_QOS_ENABLED=1

# EIOTCLUB LTE dongle uplink.
FPV_LTE_UPLINK_KBIT=8000

# Home / hotspot Wi-Fi uplink (the Pi 3 B v1.2 is 2.4 GHz 802.11n only).
FPV_WIFI_UPLINK_KBIT=15000

# Wired Ethernet (bench use).
FPV_ETH_UPLINK_KBIT=90000

# -- Link manager (fpv-link-manager.service) ---------------------------------

# Host pinged through each interface to judge link health.
PROBE_TARGET=1.1.1.1

# Seconds between probes.
PROBE_INTERVAL=2

# Consecutive failed probes before LTE is demoted below Wi-Fi.
FAIL_THRESHOLD=3

# Consecutive good probes before LTE is promoted back to primary.
RECOVER_THRESHOLD=5

# Consecutive failed probes (with no Wi-Fi to fall back to) before the LTE
# connection is bounced with nmcli.
BOUNCE_AFTER=30

# NetworkManager connection id of the LTE dongle profile.
LTE_CONN=lte-usb
