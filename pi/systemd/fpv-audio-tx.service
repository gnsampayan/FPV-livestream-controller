[Unit]
Description=FPV Audio TX Service (Pi mic -> Janus)
After=network-online.target NetworkManager-wait-online.service sound.target
Wants=network-online.target NetworkManager-wait-online.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=audio
WorkingDirectory=/home/pi/fpv

# Deployment secrets (JANUS_HOST) are loaded from fpv.env.
EnvironmentFile=/home/pi/fpv/fpv.env
Environment="JANUS_AUDIO_PORT=5006"

# USB mic device. Run `arecord -l` on the Pi to find your card/device numbers.
# `plughw:1,0` is the typical USB audio gadget when the analog jack is card 0.
Environment="MIC_DEVICE=plughw:1,0"

Environment="AUDIO_SAMPLE_RATE=48000"
Environment="AUDIO_CHANNELS=1"
Environment="OPUS_BITRATE=24000"
Environment="OPUS_FRAME_SIZE=20"
Environment="OPUS_PT=111"
Environment="RTP_MTU=1200"

ExecStart=/home/pi/fpv/audio-stream-tx.sh
Restart=always
RestartSec=5

MemoryMax=64M
CPUQuota=20%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fpv-audio-tx

[Install]
WantedBy=multi-user.target
