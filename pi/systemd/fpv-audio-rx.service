[Unit]
Description=FPV Audio RX Service (Janus -> Pi speaker)
After=network-online.target NetworkManager-wait-online.service sound.target
Wants=network-online.target NetworkManager-wait-online.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=audio
WorkingDirectory=/home/pi/fpv

# Defaults. fpv.env (loaded below) overrides these.
#
# AUDIO_RX_PORT is the UDP port the Janus AudioBridge RTP forwarder targets.
# Must match AUDIO_RX_PORT in the audiobridge-bootstrap service in
# docker-compose.yml.
#
# SPK_DEVICE is best set by running scripts/fpv-audio-detect.sh --write,
# which stores a stable ALSA card id instead of a card number.
Environment="AUDIO_RX_PORT=5008"
Environment="OPUS_PT=111"
Environment="JITTER_LATENCY_MS=40"
Environment="SPK_DEVICE=plughw:1,0"

# Optional overrides (the file is not required for this unit to start).
EnvironmentFile=-/home/pi/fpv/fpv.env

ExecStart=/home/pi/fpv/audio-receive.sh
Restart=always
RestartSec=2

# Core 2 + real-time priority (shared with audio TX).
CPUAffinity=2
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=40

# Safety net only.
MemoryMax=64M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fpv-audio-rx

[Install]
WantedBy=multi-user.target
