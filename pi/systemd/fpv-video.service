[Unit]
Description=FPV Video Streaming Service
After=network-online.target NetworkManager-wait-online.service
Wants=network-online.target NetworkManager-wait-online.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video
WorkingDirectory=/home/pi/fpv

# Defaults. Anything set in fpv.env (loaded below) overrides these, so tune
# the stream there instead of editing this unit. See fpv.env.example.
Environment="JANUS_PORT=5004"
Environment="VIDEO_PRESET=latency"
Environment="RTP_MTU=1200"
Environment="CAMERA_STACK=auto"

# Deployment secrets and overrides (JANUS_HOST, VIDEO_*).
EnvironmentFile=/home/pi/fpv/fpv.env

ExecStart=/home/pi/fpv/video-stream.sh
Restart=always
RestartSec=2

# Core plan for the Pi 3 (4x Cortex-A53):
#   core 0 - kernel, USB/Ethernet/Wi-Fi interrupts, journald
#   core 1 - control daemon (SCHED_FIFO)
#   core 2 - audio TX/RX (SCHED_FIFO)
#   core 3 - video host threads + RTP payloader (this unit)
# The H.264 encode itself runs on the VideoCore IV, not on these cores.
#
# No CPUQuota on purpose: cgroup quotas throttle in 100 ms windows, which
# shows up as periodic video stalls. Priority and affinity do the job
# without that jitter.
CPUAffinity=3
Nice=-10
CPUWeight=500

# Safety net only; the dma-buf frame buffers are not charged here.
MemoryMax=384M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fpv-video

[Install]
WantedBy=multi-user.target
