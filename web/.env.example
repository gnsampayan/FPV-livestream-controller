# -------------------------------------------------------------------
# FPV web client build-time configuration
# -------------------------------------------------------------------
# Copy to .env.local and edit:
#   cp .env.example .env.local
#
# Vite reads VITE_* variables at build time (`npm run build`) and dev
# server start (`npm run dev`). Changes require a rebuild/restart.
#
# Note: .env.local is gitignored and also not shipped to the browser
# as a file - but its VALUES are baked into the compiled JS bundle,
# so treat VITE_AUTH_TOKEN as a shared secret (visible in DevTools),
# not a per-user credential.

# Must exactly match CONTROL_AUTH_TOKEN in server/.env.
# Generate one with: openssl rand -hex 32
VITE_AUTH_TOKEN=changeme
