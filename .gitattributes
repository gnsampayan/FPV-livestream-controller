*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf

# Files that are deployed to Linux (the Raspberry Pi) must keep LF line
# endings even when checked out on Windows: a CR in a shebang, systemd unit,
# or NetworkManager profile breaks parsing.
*.py text eol=lf
*.service text eol=lf
*.rules text eol=lf
*.conf text eol=lf
*.nmconnection text eol=lf
pi/network/dispatcher/* text eol=lf
pi/fpv.env.example text eol=lf
pi/network/fpv-network.env.example text eol=lf

# Mark vendored JS libraries so GitHub Linguist excludes them from
# the repository language breakdown.
web/public/vendor/** linguist-vendored
