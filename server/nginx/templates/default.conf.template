# Rendered by the nginx:alpine entrypoint on startup:
#   /etc/nginx/templates/default.conf.template  ->  /etc/nginx/conf.d/default.conf
# Only ${SERVER_DOMAIN} is substituted (see NGINX_ENVSUBST_FILTER on the
# nginx service in docker-compose.yml). All other $variables are left
# untouched so nginx can evaluate them at request time.

# -------- Port 80 --------
# Two jobs: serve the Let's Encrypt HTTP-01 challenge (certbot uses the
# shared /var/www/certbot volume), and redirect everything else to HTTPS.
server {
    listen 80;
    server_name ${SERVER_DOMAIN};

    # ACME challenge must stay on HTTP, not redirect.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    # Health check stays available on HTTP for uptime probes.
    location /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# -------- Port 443 --------
server {
    # We intentionally do NOT enable HTTP/2 here. With `listen 443 ssl http2;`,
    # Chrome will sometimes attempt to multiplex a WebSocket upgrade onto the
    # existing h2 connection (RFC 8441 "Extended CONNECT"). Nginx does not
    # advertise SETTINGS_ENABLE_CONNECT_PROTOCOL, and instead of falling back
    # cleanly to a fresh HTTP/1.1 connection, Chrome drops the upgrade silently:
    # the request never hits the access log and the browser reports 1006 with
    # no server-side trace. curl (which we use to sanity-check nginx) always
    # forces HTTP/1.1 so it never hit this path, which is why manual tests
    # succeeded while the real browser failed.
    #
    # FPV streaming does ~all its traffic over WebSocket/WebRTC anyway, so the
    # h2 multiplexing benefit for the initial static bundle is negligible here.
    # If h2 is ever re-enabled, also audit whether libnginx supports Extended
    # CONNECT (1.25.1+ with http2_connect_protocol or similar) so WS doesn't
    # regress.
    listen 443 ssl;
    server_name ${SERVER_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${SERVER_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;

    # React app - SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Janus WebSocket proxy
    location /janus {
        proxy_pass http://janus_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;

        # Critical for WebSockets: do not buffer upstream frames.
        # With buffering ON (the default), nginx waits to accumulate response
        # chunks from janus before relaying them, which breaks WebSocket frame
        # boundaries and leaves the client stuck seeing "101 Switching Protocols"
        # with zero bytes flowing (exactly what the access log showed: `101 0`).
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # Control relay WebSocket proxy (rate limited).
    # Trailing slash on proxy_pass strips the "/ws/control" prefix so the
    # upstream sees path "/", which is what the ws server is bound to
    # (server/control-relay/src/index.ts: new WebSocketServer({ server, path: '/' })).
    # Without this, control-relay replies 400 "Bad Request" to the upgrade.
    location /ws/control {
        limit_req zone=control burst=50 nodelay;

        proxy_pass http://control_relay/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;

        # Same reason as /janus: WebSocket frames must be streamed, not buffered.
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }
}
