# -------------------------------------------------------------------
# FPV server environment
# -------------------------------------------------------------------
# Copy to .env and edit:
#   cp .env.example .env
#
# All variables below are read by docker-compose.yml at `docker compose up`
# time, so changes require a compose restart.

# -- Required ---------------------------------------------------------

# Shared secret presented by every WebSocket client (Pi daemon + browsers)
# to the control-relay. Compose maps this host variable onto the container
# as AUTH_TOKEN.
CONTROL_AUTH_TOKEN=changeme

# Public hostname served by nginx (server_name) and used by certbot when
# requesting Let's Encrypt certificates. Must resolve to this host's
# public IP before running scripts/init-tls.sh.
SERVER_DOMAIN=your.domain.com

# Email Let's Encrypt uses for renewal reminders and account recovery.
LETSENCRYPT_EMAIL=you@example.com

# Tailscale IP of the Raspberry Pi. Used by the audiobridge-bootstrap
# sidecar to register an RTP forwarder so AudioBridge ships browser-pushed
# audio to the Pi (where pi/audio-receive.sh decodes Opus and plays it
# through the USB speaker). Find it with `tailscale ip -4` on the Pi.
PI_TAILSCALE_IP=100.x.x.x

# Janus NAT mapping -- comma-separated public IP and LAN IP.
# Janus advertises these in ICE candidates instead of the Docker bridge IP.
# Without correct values here, remote viewers won't receive video/audio.
NAT_1_1_MAPPING=YOUR_PUBLIC_IP,YOUR_LAN_IP

# Janus admin API secret (protects the admin HTTP endpoint).
JANUS_ADMIN_SECRET=changeme

# AudioBridge admin key (used by the janus plugin and bootstrap sidecar
# to authorize RTP forwarder registration). Must match in both places.
AUDIOBRIDGE_ADMIN_KEY=changeme

# -- Optional overrides ----------------------------------------------
# Uncomment only if you need to change the defaults baked into the
# control-relay container (defaults in docker-compose.yml and src code).

# PORT=3001
# PI_RECONNECT_INTERVAL=5000
